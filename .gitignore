# --- Security: never commit secrets, credentials or private data ---
# Environment files (only the template is tracked)
.env.*
!.env.example
# Credentials / account notes
/test user
*credentials*
*.secret
# Keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
# Database dumps and local databases
*.sql
*.sql.gz
*.sqlite
*.sqlite3
# Private uploads (verification documents, call audio) — already ignored in storage/, kept explicit
/storage/app/private/*
!/storage/app/private/.gitignore
# Local tool settings
/.claude/settings.local.json
